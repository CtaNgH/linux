ccflags-y += -I$(src)/vendor-include

# Minimal chopin build of the vendor mediatek_v2 display stack.
# DP/HDMI/DPI, mi_disp, ca and the Xiaomi corner-pattern extras are left out
# on purpose (they are not needed to light up the DSI panel and would multiply
# the dependency surface).
mediatek-v2-y := \
	mtk_drm_drv.o mtk_drm_crtc.o mtk_drm_ddp.o mtk_drm_ddp_comp.o \
	mtk_drm_plane.o mtk_drm_gem.o mtk_drm_fb.o \
	mtk_dump.o \
	mtk_log.o mtk_drm_helper.o mtk_rect.o mtk_drm_trace.o \
	mtk_fence.o \
	mtk_disp_ovl.o mtk_disp_rdma.o mtk_disp_color.o mtk_disp_ccorr.o \
	mtk_disp_aal.o mtk_disp_gamma.o mtk_disp_dither.o mtk_disp_postmask.o \
	mtk_disp_dsc.o \
	\
	mtk_dsi.o mtk_mipi_tx.o mtk_panel_ext.o \
	\
	mtk_cmdq_dummy.o
# Files that do not exist in every vendor drop are filtered by the shell below.
obj-$(CONFIG_DRM_MEDIATEK_V2) += mediatek-v2.o
