/*
 * chopin: the panel node itself.
 */

&{/dsi@1400e000/panel@0} {
	compatible = "l16_36_02_0b_dsc_vdo,lcm";
	status = "okay";

	/*
	 * The panel's DVDD is the first WL2866D's LDO 1, which the regulator
	 * driver programmes to 1.2 V from that node's init-voltage.  Declaring
	 * it here is what makes the panel driver's regulator_get("dvdd") return
	 * the real rail rather than a dummy; the panel only ever enables it.
	 */
	dvdd-supply = <&{/i2c7@11D03000/willsemi,ldo@28/on,wl2866d1@1}>;

	/*
	 * The backlight device the LM36273 registers on its own node.  This is
	 * what lets lcm_prepare() and lcm_disable() drive the backlight through
	 * the class, and it is how the level survives a power-down: the panel
	 * switches the backlight off without knowing what the level was, and the
	 * class puts the user's level back on the way up.
	 *
	 * Deliberately absent until now.  With no phandle, ctx->backlight was
	 * NULL and those blocks were no-ops - which kept the panel from switching
	 * the backlight off at all, and was the right thing while the power-down
	 * was not yet wanted.  It is wanted now.
	 */
	backlight = <&{/i2c6@11F01000/i2c_lcd_bias@11}>;
};
