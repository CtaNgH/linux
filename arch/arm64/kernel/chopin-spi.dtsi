/*
 * chopin: spi0..7.
 */

&{/spi0@1100a000} {
	clocks = <&{/topckgen@10000000} CLK_TOP_MAINPLL_D5_D4>,
		 <&{/topckgen@10000000} CLK_TOP_SPI_SEL>,
		 <&{/infracfg_ao@10001000} CLK_INFRA_AO_SPI0>;
	clock-names = "parent-clk", "sel-clk", "spi-clk";
};

&{/spi1@11010000} {
	clocks = <&{/topckgen@10000000} CLK_TOP_MAINPLL_D5_D4>,
		 <&{/topckgen@10000000} CLK_TOP_SPI_SEL>,
		 <&{/infracfg_ao@10001000} CLK_INFRA_AO_SPI1>;
	clock-names = "parent-clk", "sel-clk", "spi-clk";
};

&{/spi2@11012000} {
	clocks = <&{/topckgen@10000000} CLK_TOP_MAINPLL_D5_D4>,
		 <&{/topckgen@10000000} CLK_TOP_SPI_SEL>,
		 <&{/infracfg_ao@10001000} CLK_INFRA_AO_SPI2>;
	clock-names = "parent-clk", "sel-clk", "spi-clk";
};

&{/spi3@11013000} {
	clocks = <&{/topckgen@10000000} CLK_TOP_MAINPLL_D5_D4>,
		 <&{/topckgen@10000000} CLK_TOP_SPI_SEL>,
		 <&{/infracfg_ao@10001000} CLK_INFRA_AO_SPI3>;
	clock-names = "parent-clk", "sel-clk", "spi-clk";
