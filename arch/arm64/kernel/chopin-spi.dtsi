&{/spi5@11019000} {
	clocks = <&{/topckgen@10000000} CLK_TOP_MAINPLL_D5_D4>,
		 <&{/topckgen@10000000} CLK_TOP_SPI_SEL>,
		 <&{/infracfg_ao@10001000} CLK_INFRA_AO_SPI5>;
