// SPDX-License-Identifier: GPL-2.0-only
/*
 * chopin: i2c6, where the LCD bias chip sits.
 */

&{/i2c6@11F01000} {
	compatible = "mediatek,mt8192-i2c";
	clocks = <&{/infracfg_ao@10001000} CLK_INFRA_AO_I2C6>,
		 <&{/infracfg_ao@10001000} CLK_INFRA_AO_APDMA>;
	clock-names = "main", "dma";
};

/*
 * The base (vendor) tree describes the pin controller with its own binding -
 * compatible "mediatek,mt6885-pinctrl" plus reg_bases phandles - which no
 * mainline driver matches, so on this port no pin has ever been claimable and
 * every GPIO consumer (the MT6360's interrupt, the touchscreen, the fingerprint,
 * the USB switch) had nothing to stand on.  Restate the node the way the
 * mainline binding - and our own mt6893-xiaomi-chopin.dts - describes it: nine
 * register windows in this exact order, their reg-names, and the mainline
 * two-cell interrupt spec.  The port already fixed the driver side of this
 * (commit "pinctrl: mediatek: fix MT6893 register base names and EINT window").
 */
