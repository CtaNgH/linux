/*
 * chopin: pin controller.
 */

&{/pinctrl} {
	compatible = "mediatek,mt6893-pinctrl";
	reg = <0x00 0x10005000 0x00 0x1000>,
	      <0x00 0x11c20000 0x00 0x1000>,
	      <0x00 0x11d10000 0x00 0x1000>,
	      <0x00 0x11e20000 0x00 0x1000>,
	      <0x00 0x11e70000 0x00 0x1000>,
	      <0x00 0x11ea0000 0x00 0x1000>,
	      <0x00 0x11f20000 0x00 0x1000>,
	      <0x00 0x11f30000 0x00 0x1000>,
	      <0x00 0x1000b000 0x00 0x1000>;
	reg-names = "base", "rm", "bm", "lm", "lb", "rt", "lt", "tm", "eint";
	interrupt-parent = <&{/interrupt-controller}>;
	#interrupt-cells = <0x02>;
	/* vendor leftovers: the mainline binding is additionalProperties: false
	 * and lists the same windows through reg/reg-names instead */
	/delete-property/ reg_bases;
	/delete-property/ reg_base_eint;
};


/*
 * I2C0 is where the fuel gauge sits.  Same vendor-binding problem as I2C6: the
 * base tree's compatible and clock phandles match no mainline driver, so the bus
 * would never probe and the gauge would never be reachable.
 */
/*
 * I2C5 is the sub-PMIC bus, and it is where the MT6360 actually is.  The base
 * tree - LK's own tree, which talked to this chip successfully - says so
 * unambiguously:
 *
 *     i2c5@11F00000: subpmic@34, usb_type_c@4e, subpmic_pmic@1a, subpmic_ldo@64
 *
 * and those four addresses are exactly what mainline's mt6360-core.h names:
 * MT6360_PMU_SLAVEID 0x34, MT6360_TCPC_SLAVEID 0x4e, MT6360_PMIC_SLAVEID 0x1a,
 * MT6360_LDO_SLAVEID 0x64.  The MFD creates a regmap for each of them itself, so
 * only the PMU node needs a driver binding.
 *
 * Same vendor-binding problem as i2c0/i2c6, and it is why the chip stayed
 * invisible: without this the controller never probed at all.
 */
