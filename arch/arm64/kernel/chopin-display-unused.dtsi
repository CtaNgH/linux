/*
 * chopin: display components left disabled.
 */

&{/disp_ovl@14002000} {
	status = "disabled";
};

&{/disp_rdma@14005000} {
	status = "disabled";
};

&{/disp_wdma@14006000} {
	compatible = "mediatek,mt6873-disp-wdma";
	mediatek,larb = <&smi_larb0>;
	mediatek,smi-id = <0>;
	status = "okay";
};

&{/disp_rsz@1400c000} {
	status = "disabled";
};

&{/mdp_aal4@14010000} {
	status = "disabled";
};

&{/disp_merge@14015000} {
	status = "disabled";
};

&{/disp_ovl@14100000} {
	status = "disabled";
};

&{/disp_ovl@14101000} {
	status = "disabled";
};

&{/disp_ovl@14102000} {
	status = "disabled";
};

&{/disp_rdma@14103000} {
	status = "disabled";
};

&{/disp_rdma@14105000} {
	status = "disabled";
};

&{/disp_wdma@14106000} {
	status = "disabled";
};

&{/disp_color@14107000} {
	status = "disabled";
};

&{/disp_ccorr@14108000} {
	status = "disabled";
};

&{/disp_aal@14109000} {
	status = "disabled";
};

&{/disp_gamma@1410a000} {
	status = "disabled";
};

&{/disp_dither@1410b000} {
	status = "disabled";
};

&{/disp_rsz@1410c000} {
	status = "disabled";
};

&{/disp_postmask@1410d000} {
	status = "disabled";
